# Copy this file to `.env` and fill in the values you need.
#
# `.env` is git-ignored and packages are assembled from an explicit file list,
# so nothing here can reach a commit or a release. `.env.example` is the only
# variant that is tracked, and it must never contain a real secret.

# VirusTotal API key, used by scripts/Get-VirusTotalVerdict.py to look up and
# submit package binaries. Free keys come from your VirusTotal profile menu ->
# API key, with a quota of 4 requests/minute and 500/day.
VIRUSTOTAL_API_KEY=your-key-here

# Nexus Mods. The file id comes from the mod page under Files -> Advanced.
# The mod id is NOT the 3374 from the page URL; confirm it with
# scripts/Get-NexusModStatus.ps1 before relying on it for changelog uploads.
NEXUSMODS_API_KEY=your-key-here
NEXUSMODS_FILE_ID=7891854
# NEXUSMODS_MOD_ID=
