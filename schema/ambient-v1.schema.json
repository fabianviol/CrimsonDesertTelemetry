{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crimson Desert global sky ambient v1",
  "type": "object",
  "required": ["schemaVersion", "status", "source", "scope", "units", "localOcclusionIncluded", "exposureNormalized", "directSunMoonSeparated", "colorInterpretation"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "status": {"enum": ["available", "unavailable"]},
    "source": {"const": "precompute-ambient-sky"},
    "scope": {"const": "global-upper-hemisphere-sky"},
    "units": {"const": "relative-shader-units"},
    "localOcclusionIncluded": {"const": false},
    "exposureNormalized": {"const": false},
    "directSunMoonSeparated": {"const": false},
    "colorInterpretation": {"type": "string"},
    "reason": {"type": ["string", "null"]},
    "captureSequence": {"type": ["integer", "null"], "minimum": 1},
    "frameNumber": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295},
    "capturedAt": {"type": ["string", "null"], "format": "date-time"},
    "ageMilliseconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 1500},
    "sky": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sky"}]}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "available"}}},
    "then": {
      "required": ["captureSequence", "frameNumber", "capturedAt", "ageMilliseconds", "sky"],
      "properties": {
        "sky": {"$ref": "#/$defs/sky"},
        "captureSequence": {"type": "integer"}, "frameNumber": {"type": "integer"},
        "capturedAt": {"type": "string"}, "ageMilliseconds": {"type": "integer"},
        "reason": {"type": "null"}
      }
    },
    "else": {
      "required": ["reason"],
      "properties": {"reason": {"type": "string", "minLength": 1}, "sky": {"type": "null"},
        "captureSequence": {"type": "null"}, "frameNumber": {"type": "null"},
        "capturedAt": {"type": "null"}, "ageMilliseconds": {"type": "null"}}
    }
  }],
  "$defs": {
    "rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "sky": {
      "type": "object",
      "required": ["coefficientsWorking", "upperHemisphereMeanWorking", "upwardIrradianceOverPiWorking", "inverseMatrixMean", "inverseMatrixUpwardIrradianceOverPi", "rec709MeanLuminanceEstimate"],
      "properties": {
        "coefficientsWorking": {"type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number"}}},
        "upperHemisphereMeanWorking": {"$ref": "#/$defs/rgb"},
        "upwardIrradianceOverPiWorking": {"$ref": "#/$defs/rgb"},
        "inverseMatrixMean": {"$ref": "#/$defs/rgb"},
        "inverseMatrixUpwardIrradianceOverPi": {"$ref": "#/$defs/rgb"},
        "rec709MeanLuminanceEstimate": {"type": "number"}
      }
    }
  }
}
