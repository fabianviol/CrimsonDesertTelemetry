{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crimson Desert Telemetry snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "capturedAt", "game", "coordinateSystem", "capabilities", "player", "camera", "quality"],
  "properties": {
    "schemaVersion": { "enum": ["1.1", "1.2", "1.3"] },
    "sequence": { "type": "integer", "minimum": 0 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "state"],
      "properties": {
        "build": { "type": "string" },
        "state": { "enum": ["playing", "loading", "stopped"] }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "handedness", "upAxis"],
      "properties": {
        "unit": { "const": "game-unit" },
        "handedness": { "const": "right" },
        "upAxis": { "const": "y" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "player": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["position"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "orientation": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source", "forward", "up", "headingDegrees"],
                  "properties": {
                    "source": { "const": "player-physics-root" },
                    "forward": { "$ref": "#/$defs/vector3" },
                    "up": { "$ref": "#/$defs/vector3" },
                    "headingDegrees": { "type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360 }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "camera": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "up", "right", "forward", "nearPlane", "farPlane", "verticalFovDegrees", "aspectRatio"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "up": { "$ref": "#/$defs/vector3" },
            "right": { "$ref": "#/$defs/vector3" },
            "forward": { "$ref": "#/$defs/vector3" },
            "nearPlane": { "type": "number", "exclusiveMinimum": 0 },
            "farPlane": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "verticalFovDegrees": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 },
            "aspectRatio": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "quality": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["consensusCopies", "validCopies", "distinctStates", "rediscovered", "captureDurationMicroseconds"],
          "properties": {
            "consensusCopies": { "type": "integer", "minimum": 1 },
            "validCopies": { "type": "integer", "minimum": 1 },
            "distinctStates": { "type": "integer", "minimum": 1 },
            "rediscovered": { "type": "boolean" },
            "captureDurationMicroseconds": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "lights": {
      "$ref": "#/$defs/engineLights"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "enum": ["1.2", "1.3"] } }, "required": ["schemaVersion"] },
      "then": { "required": ["lights"] },
      "else": { "not": { "required": ["lights"] } }
    }
  ],
  "$defs": {
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "engineLights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "nearbyRadius", "diagnostics"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "source": { "const": "engine-light-source-array" },
        "nearbyRadius": { "type": "number", "minimum": 1, "maximum": 100000 },
        "sources": {
          "type": "array",
          "maxItems": 8192,
          "items": { "$ref": "#/$defs/engineLight" }
        },
        "diagnostics": { "$ref": "#/$defs/engineLightDiagnostics" },
        "unavailableReason": {
          "enum": ["unsupported-build", "walk-unavailable", "player-unavailable", "required-telemetry-unavailable", "game-stopped"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } }, "required": ["status"] },
          "then": { "required": ["sources"] },
          "else": { "required": ["unavailableReason"] }
        }
      ]
    },
    "engineLight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "colorLinear", "recordActive", "rendererSelected"],
      "dependentRequired": {
        "rendererScale": ["rendererRgbLinear"],
        "rendererRgbLinear": ["rendererScale"]
      },
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "kind": { "enum": ["point", "spot"] },
        "direction": { "$ref": "#/$defs/vector3" },
        "colorLinear": { "$ref": "#/$defs/vector3" },
        "recordActive": { "type": "boolean" },
        "rendererSelected": { "type": "boolean" },
        "rendererScale": { "type": "number", "exclusiveMinimum": 0 },
        "rendererRgbLinear": { "$ref": "#/$defs/vector3" }
      }
    },
    "engineLightDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRecords", "publishedRecords", "malformed", "outsideRadius", "unsupportedKind",
        "rendererDataUnavailable", "nonPositiveRendererScale", "walkChanged", "walkRetrySucceeded", "walkUnavailable"],
      "properties": {
        "sourceRecords": { "type": "integer", "minimum": 0 },
        "publishedRecords": { "type": "integer", "minimum": 0 },
        "malformed": { "type": "integer", "minimum": 0 },
        "outsideRadius": { "type": "integer", "minimum": 0 },
        "unsupportedKind": { "type": "integer", "minimum": 0 },
        "rendererDataUnavailable": { "type": "integer", "minimum": 0 },
        "nonPositiveRendererScale": { "type": "integer", "minimum": 0 },
        "walkChanged": { "type": "integer", "minimum": 0 },
        "walkRetrySucceeded": { "type": "integer", "minimum": 0 },
        "walkUnavailable": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
