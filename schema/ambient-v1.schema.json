{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crimson Desert sky ambient and local camera visibility v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "source",
    "scope",
    "units",
    "localOcclusionIncluded",
    "exposureNormalized",
    "directSunMoonSeparated",
    "colorInterpretation",
    "localEnvironmentAmbientEstimateWorking"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "source": {
      "const": "precompute-ambient-sky"
    },
    "scope": {
      "const": "global-upper-hemisphere-sky"
    },
    "units": {
      "const": "relative-shader-units"
    },
    "localOcclusionIncluded": {
      "const": false
    },
    "exposureNormalized": {
      "const": false
    },
    "directSunMoonSeparated": {
      "const": false
    },
    "colorInterpretation": {
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "captureSequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "frameNumber": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4294967295
    },
    "capturedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ageMilliseconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1500
    },
    "sky": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sky"
        }
      ]
    },
    "visibility": {
      "type": [
        "object",
        "null"
      ],
      "description": "Local camera sky visibility from production spatial sampling, on its own cadence. Present only for a valid voxel texture sample; the shader fallback branch is deliberately not reported as a measurement. Null when disabled or unavailable. Its freshness is independent of the global sky sample.",
      "properties": {
        "valueWorking": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "saturate(1 - sampled), raw and unnormalised."
        },
        "frameNumber": {
          "type": "integer",
          "description": "Its own frame, not the sky sample’s."
        },
        "ageMilliseconds": {
          "type": "integer",
          "description": "Its own age, on the same monotonic base."
        }
      }
    },
    "localEnvironmentAmbientEstimateWorking": {
      "type": [
        "object",
        "null"
      ],
      "description": "Derived working-space estimate: global upper-hemisphere sky mean multiplied by local camera sky visibility. This is not an exact renderer term or physical lux; the engine modulates an environment cube while this API modulates an averaged sky value. Both raw inputs and their independent freshness remain available in the response.",
      "properties": {
        "rgbWorking": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "available": {
          "type": "boolean",
          "description": "True only for a real texture sample within its freshness bound."
        },
        "stale": {
          "type": "boolean",
          "description": "Visibility exists but is too old; no value is emitted."
        },
        "basis": {
          "type": "string"
        }
      },
      "required": [
        "available",
        "stale",
        "basis"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "available"
          }
        }
      },
      "then": {
        "required": [
          "captureSequence",
          "frameNumber",
          "capturedAt",
          "ageMilliseconds",
          "sky"
        ],
        "properties": {
          "sky": {
            "$ref": "#/$defs/sky"
          },
          "captureSequence": {
            "type": "integer"
          },
          "frameNumber": {
            "type": "integer"
          },
          "capturedAt": {
            "type": "string"
          },
          "ageMilliseconds": {
            "type": "integer"
          },
          "reason": {
            "type": "null"
          },
          "localEnvironmentAmbientEstimateWorking": {
            "type": "object"
          }
        }
      },
      "else": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "sky": {
            "type": "null"
          },
          "captureSequence": {
            "type": "null"
          },
          "frameNumber": {
            "type": "null"
          },
          "capturedAt": {
            "type": "null"
          },
          "ageMilliseconds": {
            "type": "null"
          },
          "localEnvironmentAmbientEstimateWorking": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "sky": {
      "type": "object",
      "required": [
        "coefficientsWorking",
        "upperHemisphereMeanWorking",
        "upwardIrradianceOverPiWorking",
        "inverseMatrixMean",
        "inverseMatrixUpwardIrradianceOverPi",
        "rec709MeanLuminanceEstimate"
      ],
      "properties": {
        "coefficientsWorking": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "items": {
              "type": "number"
            }
          }
        },
        "upperHemisphereMeanWorking": {
          "$ref": "#/$defs/rgb"
        },
        "upwardIrradianceOverPiWorking": {
          "$ref": "#/$defs/rgb"
        },
        "inverseMatrixMean": {
          "$ref": "#/$defs/rgb"
        },
        "inverseMatrixUpwardIrradianceOverPi": {
          "$ref": "#/$defs/rgb"
        },
        "rec709MeanLuminanceEstimate": {
          "type": "number"
        }
      }
    }
  }
}
